<Window x:Class="SMBot.Views.ChecklistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SMBot checklist" Width="400" Height="580" MinWidth="320" MinHeight="380"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" Icon="/Assets/smbot.ico"
        SourceInitialized="Window_SourceInitialized">

    <!-- White at the top fading to light purple -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#F6F1FF" Offset="0.45"/>
            <GradientStop Color="#E9E0FF" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#3B2F66"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8A7DB8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#8A6FE0"/>

        <Style x:Key="PurpleButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="#9B82EA" CornerRadius="10" Padding="16,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#8A6FE0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded input with a placeholder hint shown while it's empty -->
        <Style x:Key="AddBoxStyle" TargetType="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame" Background="White" BorderBrush="#D9CCFA" BorderThickness="1.5" CornerRadius="10" Padding="10,7">
                            <Grid>
                                <TextBlock x:Name="Hint" Text="Add a task, e.g. call Ali tomorrow 3pm" Foreground="#B3A8D6" IsHitTestVisible="False" Visibility="Collapsed"/>
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#9B82EA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rounded progress bar -->
        <Style x:Key="RoundProgress" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" Background="#EAE2FF" CornerRadius="4"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#C3B1F5" Offset="0"/>
                                        <GradientStop Color="#9B82EA" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Round purple tick box -->
        <Style x:Key="RoundCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="20" Height="20">
                            <Ellipse x:Name="Ring" Stroke="#B9A6F2" StrokeThickness="1.8" Fill="White"/>
                            <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Fill" Value="#9B82EA"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="#9B82EA"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#8A6FE0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- White rounded card for each task -->
        <Style x:Key="TaskCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#ECE4FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#7B61D6" BlurRadius="10" ShadowDepth="1" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DeleteButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Delete"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="Transparent" CornerRadius="6" Width="24" Height="24">
                            <TextBlock x:Name="Glyph" Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                       Foreground="#B3A8D6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#F3EEFF"/>
                                <Setter TargetName="Glyph" Property="Foreground" Value="#8A6FE0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,16,20,12">
        <!-- Header with the SMBot head, and today's progress -->
        <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal">
                <!-- Full-size PNG (the .ico's small frames look blurry when WPF scales them up) -->
                <Image Source="/Assets/smbot-head.png" Width="50" Height="50" Margin="-4,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Checklist" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="ProgressText" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </StackPanel>
            <ProgressBar x:Name="Progress" Height="8" Maximum="1" Margin="0,12,0,0" Style="{StaticResource RoundProgress}"/>
        </StackPanel>

        <!-- Quick add -->
        <DockPanel DockPanel.Dock="Top" Margin="0,16,0,6">
            <Button DockPanel.Dock="Right" Content="Add" Style="{StaticResource PurpleButton}" Margin="8,0,0,0" Click="Add_Click"/>
            <TextBox x:Name="AddBox" Style="{StaticResource AddBoxStyle}" KeyDown="AddBox_KeyDown"/>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Sections" Margin="0,0,2,8"/>
        </ScrollViewer>
    </DockPanel>
</Window>

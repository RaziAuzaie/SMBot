<Window x:Class="SMBot.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SMBot search" Width="640" SizeToContent="Height" MaxHeight="620"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown" Icon="/Assets/smbot.ico">

    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#3B2F66"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8A7DB8"/>

        <Style x:Key="ResultItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="10,7" Margin="0,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#F6F1FF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#ECE4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FolderButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Open folder (Ctrl+Enter)"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="Transparent" CornerRadius="8" Width="30" Height="30">
                            <TextBlock Text="&#xE838;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
                                       Foreground="#9B82EA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Background" Value="#E3D8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Rounded card with a soft shadow, white fading to light purple -->
    <Border Margin="18" CornerRadius="18" BorderBrush="#D9CCFA" BorderThickness="1" Padding="14">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFFFFF" Offset="0"/>
                <GradientStop Color="#F3EDFF" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#5B44B8" BlurRadius="24" ShadowDepth="4" Opacity="0.25"/>
        </Border.Effect>

        <StackPanel>
            <!-- Search box -->
            <Border Background="White" CornerRadius="12" BorderBrush="#C9B8F5" BorderThickness="1.5" Padding="12,9">
                <DockPanel>
                    <Image DockPanel.Dock="Left" Source="/Assets/smbot-head.png" Width="30" Height="30" Margin="0,0,10,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Grid>
                        <TextBlock x:Name="Hint" Text="Search your files…   try  .pdf   type:excel   in:downloads"
                                   FontSize="16" Foreground="#B3A8D6" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        <TextBox x:Name="QueryBox" FontSize="16" Foreground="{StaticResource TextBrush}" Background="Transparent"
                                 BorderThickness="0" VerticalAlignment="Center" TextChanged="QueryBox_TextChanged"/>
                    </Grid>
                </DockPanel>
            </Border>

            <ListBox x:Name="Results" Margin="0,10,0,0" BorderThickness="0" Background="Transparent" MaxHeight="440"
                     ItemContainerStyle="{StaticResource ResultItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     MouseDoubleClick="Results_MouseDoubleClick" Visibility="Collapsed">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="18" Foreground="#8A6FE0" Width="30" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Style="{StaticResource FolderButton}" Click="FolderButton_Click" VerticalAlignment="Center"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding When, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text="{Binding Folder, Mode=OneWay, StringFormat='· {0}'}"/>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="Status" FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="4,10,4,0"/>
        </StackPanel>
    </Border>
</Window>

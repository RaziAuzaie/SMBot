<Window x:Class="SMBot.Views.BuddyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SMBot" Width="500" Height="340"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Loaded="Window_Loaded" Icon="/Assets/smbot.ico">

    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#3B2F66"/>

        <!-- Pill-shaped tabs in the speech bubble -->
        <Style x:Key="TabStyle" TargetType="ToggleButton">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Pill" Background="#F6F2FF" BorderBrush="#C9B8F5" BorderThickness="1" CornerRadius="10" Padding="10,3">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#C9B8F5"/>
                                <Setter TargetName="Pill" Property="BorderBrush" Value="#A893E0"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rows in the left-click action list: icon (Tag, a Segoe Fluent Icons glyph) and label -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="8" Padding="8,6" Margin="0,1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14" Foreground="#8A6FE0" VerticalAlignment="Center" Width="24"/>
                                <ContentPresenter VerticalAlignment="Center" TextElement.FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#F1EBFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small purple buttons in the speech bubble -->
        <Style x:Key="BubbleButton" TargetType="Button">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="#EFE9FF"/>
            <Setter Property="BorderBrush" Value="#C9B8F5"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryBubbleButton" TargetType="Button" BasedOn="{StaticResource BubbleButton}">
            <Setter Property="Background" Value="#C9B8F5"/>
            <Setter Property="BorderBrush" Value="#A893E0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Email rows: unread are just listed, unreplied can be marked as done -->
        <DataTemplate x:Key="UnreadTemplate">
            <StackPanel Margin="0,3">
                <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Sender, Mode=OneWay}"/>
                    <Run Text="{Binding Age, Mode=OneWay, StringFormat='· {0}'}" Foreground="#8A7DB8" FontWeight="Normal"/>
                </TextBlock>
                <TextBlock Text="{Binding Subject}" FontSize="11" Foreground="#5A4E85" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="UnrepliedTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Sender, Mode=OneWay}"/>
                        <Run Text="{Binding Age, Mode=OneWay, StringFormat='· {0}'}" Foreground="#8A7DB8" FontWeight="Normal"/>
                    </TextBlock>
                    <TextBlock Text="{Binding Subject}" FontSize="11" Foreground="#5A4E85" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✓ Done" ToolTip="Mark as done" Margin="6,0,0,0" Padding="6,1"
                        VerticalAlignment="Center" FontSize="11" Background="#EFE9FF" BorderBrush="#C9B8F5"
                        Foreground="{StaticResource TextBrush}" Click="DoneButton_Click"/>
            </Grid>
        </DataTemplate>

        <!-- Gentle hover bob, forever -->
        <Storyboard x:Key="Hover" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="BobTransform" Storyboard.TargetProperty="Y"
                             From="0" To="-7" Duration="0:0:1.6">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="GlowShadow" Storyboard.TargetProperty="Opacity"
                             From="0.55" To="0.3" Duration="0:0:1.6"/>
        </Storyboard>

    </Window.Resources>

    <!-- Root is scaled for the Small / Medium / Large size setting -->
    <Grid x:Name="Root">
        <Grid.LayoutTransform><ScaleTransform x:Name="SizeScale"/></Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <!-- Extra room on the right so the waving fin isn't cut off by the window edge -->
            <ColumnDefinition Width="230"/>
        </Grid.ColumnDefinitions>

        <!-- Speech bubble -->
        <Border x:Name="Bubble" Grid.Column="0" VerticalAlignment="Bottom" Margin="8,0,4,70"
                Background="White" CornerRadius="14" Padding="14,12" BorderBrush="#C9B8F5" BorderThickness="1.5">
            <Border.Effect>
                <DropShadowEffect Color="#6A55B0" BlurRadius="12" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="BubbleText" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextBrush}"/>

                <!-- Onboarding name entry -->
                <StackPanel x:Name="NamePanel" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBox x:Name="NameBox" MaxLength="30" FontSize="13" Padding="6,4"
                             BorderBrush="#A893E0" KeyDown="NameBox_KeyDown"/>
                    <TextBlock x:Name="NameHint" Text="Type a name so I know what to call you"
                               Foreground="#C0392B" FontSize="11" Margin="2,4,0,0" Visibility="Collapsed"/>
                    <Button Content="OK" HorizontalAlignment="Right" Margin="0,8,0,0" Padding="18,4"
                            Background="#C9B8F5" Foreground="{StaticResource TextBrush}" BorderBrush="#A893E0"
                            Click="OkButton_Click"/>
                </StackPanel>

                <!-- Email tabs: unread first, then unreplied -->
                <StackPanel x:Name="EmailTabs" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                    <ToggleButton x:Name="UnreadTab" Style="{StaticResource TabStyle}" Click="UnreadTab_Click"/>
                    <ToggleButton x:Name="UnrepliedTab" Style="{StaticResource TabStyle}" Margin="6,0,0,0" Click="UnrepliedTab_Click"/>
                </StackPanel>

                <!-- Top few emails of the selected tab -->
                <ItemsControl x:Name="EmailList" Margin="0,8,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="MoreEmails" FontSize="11" Foreground="#8A7DB8" Margin="0,4,0,0" Visibility="Collapsed"/>

                <!-- Feature 3: quick capture -->
                <StackPanel x:Name="CapturePanel" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBox x:Name="CaptureBox" FontSize="13" Padding="6,4" BorderBrush="#A893E0"
                             TextWrapping="Wrap" MaxHeight="64" KeyDown="CaptureBox_KeyDown"/>
                    <TextBlock Text="e.g. call Ali tomorrow 3pm, email Lim and pay bills every month end"
                               FontSize="10.5" Foreground="#8A7DB8" TextWrapping="Wrap" Margin="2,4,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Cancel" Style="{StaticResource BubbleButton}" Click="CaptureCancel_Click"/>
                        <Button Content="Add" Style="{StaticResource PrimaryBubbleButton}" Click="CaptureAdd_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- What the parser understood, before saving -->
                <StackPanel x:Name="ConfirmPanel" Margin="0,6,0,0" Visibility="Collapsed">
                    <ItemsControl x:Name="ConfirmList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,3">
                                    <TextBlock Text="{Binding Text}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding When}" FontSize="11" Foreground="#8A7DB8"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Edit" Style="{StaticResource BubbleButton}" Click="ConfirmEdit_Click"/>
                        <Button Content="Save" Style="{StaticResource PrimaryBubbleButton}" Click="ConfirmSave_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Actions for a reminder that's due -->
                <StackPanel x:Name="DuePanel" Margin="0,10,0,0" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="10 min" ToolTip="Snooze 10 minutes" Style="{StaticResource BubbleButton}" Padding="8,3" Click="Snooze10_Click"/>
                        <Button Content="1 hour" ToolTip="Snooze 1 hour" Style="{StaticResource BubbleButton}" Padding="8,3" Click="Snooze60_Click"/>
                        <Button Content="Later…" ToolTip="More snooze options" Style="{StaticResource BubbleButton}" Padding="8,3" Click="SnoozeMore_Click"/>
                        <Button Content="✓ Done" Style="{StaticResource PrimaryBubbleButton}" Padding="8,3" Click="ReminderDone_Click"/>
                    </StackPanel>
                    <!-- More snooze choices: fixed ones, or type a time -->
                    <StackPanel x:Name="SnoozeMorePanel" Margin="0,8,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="After lunch" Style="{StaticResource BubbleButton}" Padding="8,3" Click="SnoozeLunch_Click"/>
                            <Button Content="Tomorrow morning" Style="{StaticResource BubbleButton}" Padding="8,3" Click="SnoozeMorning_Click"/>
                        </StackPanel>
                        <DockPanel Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="Set" Style="{StaticResource PrimaryBubbleButton}" Padding="10,3" Click="SnoozeCustom_Click"/>
                            <Grid>
                                <TextBlock x:Name="SnoozeHint" Text="or type a time: 4pm, tomorrow 10am" FontSize="11.5" Foreground="#B3A8D6"
                                           Margin="7,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBox x:Name="SnoozeBox" FontSize="12" Padding="4,3" BorderBrush="#C9B8F5" Background="Transparent"
                                         TextChanged="SnoozeBox_TextChanged" KeyDown="SnoozeBox_KeyDown"/>
                            </Grid>
                        </DockPanel>
                        <TextBlock x:Name="SnoozeError" FontSize="11" Foreground="#C0392B" TextWrapping="Wrap" Margin="2,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>

                <!-- Several reminders went off while away: listed together instead of one pop-up each -->
                <StackPanel x:Name="MissedPanel" Margin="0,6,0,0" Visibility="Collapsed">
                    <ItemsControl x:Name="MissedList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,3">
                                    <Button DockPanel.Dock="Right" Content="✓" ToolTip="Done" Style="{StaticResource BubbleButton}" Padding="7,1"
                                            VerticalAlignment="Center" Click="MissedDone_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding When}" FontSize="11" Foreground="#8A7DB8"/>
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="MissedMore" FontSize="11" Foreground="#8A7DB8" Margin="0,2,0,0" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Snooze 1h" ToolTip="Snooze all for 1 hour" Style="{StaticResource BubbleButton}" Padding="8,3" Click="MissedSnoozeAll_Click"/>
                        <Button Content="Checklist" Style="{StaticResource BubbleButton}" Padding="8,3" Click="MissedChecklist_Click"/>
                        <Button Content="✓ All done" Style="{StaticResource PrimaryBubbleButton}" Padding="8,3" Click="MissedAllDone_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- Recently opened files: click one to open its folder -->
                <ItemsControl x:Name="RecentList" Margin="0,6,0,0" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Click="RecentFile_Click" ToolTip="{Binding FilePath}" Cursor="Hand" HorizontalContentAlignment="Stretch">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="6,3">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#F1EBFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock FontSize="10.5" Foreground="#8A7DB8" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Age, Mode=OneWay}" FontWeight="SemiBold"/>
                                        <Run Text="{Binding Folder, Mode=OneWay, StringFormat='· {0}'}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- What the bot can do, shown on left click -->
                <StackPanel x:Name="ActionPanel" Margin="0,6,0,0" Visibility="Collapsed">
                    <Button Style="{StaticResource ActionButton}" Tag="&#xE823;" Content="Add reminder" Click="ActionAddReminder_Click"/>
                    <Button Style="{StaticResource ActionButton}" Tag="&#xE9D5;" Content="Checklist" Click="ActionChecklist_Click"/>
                    <Button Style="{StaticResource ActionButton}" Tag="&#xE81C;" Content="Recent files" Click="RecentFiles_Click"/>
                    <Button Style="{StaticResource ActionButton}" Tag="&#xE715;" Content="Check emails" Click="CheckEmails_Click"/>
                    <Button Style="{StaticResource ActionButton}" Tag="&#xE721;" Content="Search files" Click="ActionSearch_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- EVE-style character (original 3D design, Soft Satin finish) -->
        <Canvas x:Name="Character" Grid.Column="1" Width="230" Height="268" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,8" Background="Transparent"
                Cursor="Hand" MouseLeftButtonDown="Character_MouseLeftButtonDown"
                MouseEnter="Character_MouseEnter" MouseLeave="Character_MouseLeave">
            <Canvas.ContextMenu>
                <!-- Everyday actions are on left click; right click only has these -->
                <ContextMenu>
                    <MenuItem Header="Size">
                        <MenuItem x:Name="SizeSmall" Header="Small" Tag="small" IsCheckable="True" Click="Size_Click"/>
                        <MenuItem x:Name="SizeMedium" Header="Medium" Tag="medium" IsCheckable="True" Click="Size_Click"/>
                        <MenuItem x:Name="SizeLarge" Header="Large" Tag="large" IsCheckable="True" Click="Size_Click"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Header="Reset onboarding" Click="Reset_Click"/>
                    <MenuItem Header="Exit" Click="Exit_Click"/>
                </ContextMenu>
            </Canvas.ContextMenu>

            <!-- Soft glow under the hovering body -->
            <Ellipse x:Name="GlowShadow" Canvas.Left="80" Canvas.Top="252" Width="70" Height="12" Fill="#B69CFF" Opacity="0.55">
                <Ellipse.Effect><BlurEffect Radius="10"/></Ellipse.Effect>
            </Ellipse>

            <!-- Pre-rendered 3D frames (design/smbot-sprites.html). FadeSprite holds the previous frame
                 while it fades out, so expression changes crossfade. -->
            <Canvas Width="230" Height="260">
                <Canvas.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="SquashScale" CenterX="115" CenterY="252"/>
                        <TranslateTransform x:Name="JumpTransform"/>
                        <TranslateTransform x:Name="BobTransform"/>
                    </TransformGroup>
                </Canvas.RenderTransform>
                <Image x:Name="Sprite" Width="230" Height="260" RenderOptions.BitmapScalingMode="HighQuality"/>
                <Image x:Name="FadeSprite" Width="230" Height="260" Opacity="0" IsHitTestVisible="False"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                <!-- How many items are due today (including overdue), by the head; hidden at 0 -->
                <Border x:Name="Badge" Canvas.Left="158" Canvas.Top="46" MinWidth="24" Height="24" CornerRadius="12" Padding="6,0"
                        BorderBrush="White" BorderThickness="2" Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#A88CF5" Offset="0"/>
                            <GradientStop Color="#7E5FDB" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="#5B44B8" BlurRadius="8" ShadowDepth="1" Opacity="0.35"/>
                    </Border.Effect>
                    <TextBlock x:Name="BadgeText" Foreground="White" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Canvas>
        </Canvas>
    </Grid>
</Window>
